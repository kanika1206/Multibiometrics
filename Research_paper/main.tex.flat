\begin{algorithm}
\caption{Face Matching}\label{alg:face-new}
\begin{algorithmic}[1]
\Require enrolled face template $e^{f}_r$; login frame embeddings $\{e^{f}_{l,i}\}_{i=1}^{n}$
\Ensure Face verdict $b_f$
\For{$i = 1$ to $n$}
    \State $s_i \gets \langle e^{f}_{r},\, e^{f}_{l,i} \rangle$ \Comment{both vectors are L2-normalized, so $s_i$ is a cosine similarity}
\EndFor
\State $s \gets \operatorname{median}(s_1,\dots,s_n)$ \Comment{robust to a minority of degraded frames}
\If{$s \geq \tau_f$}
    \State $b_f \gets 1$
\Else
    \State $b_f \gets 0$
\EndIf
\end{algorithmic}
\end{algorithm}

\begin{algorithm}
\caption{Voice Matching}\label{alg:voice-new}
\begin{algorithmic}[1]
\Require enrolled speaker embedding $e^{a}_r$; login speaker embedding $e^{a}_l$
\Ensure Voice verdict $b_a$
\If{either template lacks a speaker embedding}
    \State \Return error \Comment{a template without a speaker embedding cannot be scored; re-enrolment is required}
\EndIf
\State $s \gets \langle e^{a}_{r},\, e^{a}_{l} \rangle$ \Comment{cosine similarity of two 192-d ECAPA-TDNN embeddings}
\If{$s \geq \tau_a$}
    \State $b_a \gets 1$
\Else
    \State $b_a \gets 0$
\EndIf
\end{algorithmic}
\end{algorithm}

\begin{algorithm}
\caption{Template Extraction (enrolment and login)}\label{alg:extract}
\begin{algorithmic}[1]
\Require recording $V$
\Ensure template $\{e^{f}, \{e^{f}_{i}\}, e^{a}\}$, or failure
\State sample $m$ frames uniformly across $V$
\For{each sampled frame}
    \State detect faces; if several are present, retain the largest
    \State $e^{f}_{i} \gets$ normalized deep face embedding of the retained face
\EndFor
\If{no frame yielded a face}
    \State \Return failure \Comment{fail closed: no template is stored}
\EndIf
\State $e^{f} \gets \text{normalize}\big(\text{mean}_i\, e^{f}_{i}\big)$ \Comment{enrolled face reference}
\State demultiplex the audio track of $V$ and resample to 16\,kHz mono
\If{audio shorter than one second}
    \State \Return failure
\EndIf
\State $e^{a} \gets \text{normalize}\big(\text{ECAPA-TDNN}(\text{audio})\big)$
\end{algorithmic}
\end{algorithm}


\State \textbf{if} $a_u$ or $a_m$ contains an enrolled template \textbf{then reject}
\State delete any existing template-less $a_u,a_m$; create account $(u,\texttt{idx},m,\text{avatar})$
\State $E\gets\mathrm{Sign}_{k_{\mathrm{sig}}}(\{\texttt{username}=u,\texttt{purpose}=\mathrm{enroll}\},\texttt{ttl}=10\text{ min})$

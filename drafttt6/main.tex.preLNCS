\begin{algorithm}[!tbp]
\caption{\textcolor{black}{Login and Challenge Issuance}}
\label{alg:challenge}
\begin{algorithmic}[1]
\small
\Require identifier $u$
\Ensure server-side challenge $C$ and encrypted transient login recording $V_l$

\State validate $u$; reject if invalid
\State $C\gets$ five random digits from $\{0,\ldots,9\}$
\State store $(u,C,\texttt{expiry}=\mathrm{now}+5\text{ min})$ server-side
\State render $C$ as an SVG and transmit only the SVG to the client
\State client records login video $V_l$ while speaking $C$
\State client uploads $V_l$ with filename $u'\texttt{\_l.mp4}$
\State validate filename; reject if invalid
\State $u'\gets$ identifier extracted from the validated filename
\State \textbf{if} no unexpired challenge exists for $u'$ \textbf{then reject}
\State $C_l\gets\mathrm{Enc}^{\mathrm{AES\text{-}256\text{-}GCM}}_{k_{\mathrm{bio}}}(V_l)$
\State store $C_l$ as a transient encrypted login recording
\State \Return authentication request
\end{algorithmic}
\end{algorithm}






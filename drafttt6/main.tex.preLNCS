\State \textbf{Biometric enrolment:}
\State client uploads $V_r$ with enrollment token $E$
\State verify $E$; reject if missing, invalid, expired, or malformed
\State $u'\gets$ username claim of $E$
\State $a\gets\mathrm{Find}(u')$
\State \textbf{if} $a$ does not exist, filename is invalid, or $a$ already has a template \textbf{then reject}
\State $T_r\gets\textsc{ExtractTemplate}(V_r)$
